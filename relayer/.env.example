# Recourse relayer — copy to .env and fill in. Never commit the filled-in copy.
#
# Run with:   node --env-file=.env dist/index.js
# (Node 20.6+ reads .env natively, which is why this project has no dotenv
# dependency. `--env-file` does not override variables already set in the
# environment, so `DRY_RUN=true node --env-file=.env dist/index.js` works.)

# --- Base Sepolia ----------------------------------------------------------

# Any Base Sepolia RPC. A public one is fine for the demo; a keyed provider is
# more reliable during a live presentation.
BASE_RPC_URL=https://sepolia.base.org

# The deployed RecourseEscrow.
ESCROW_ADDRESS=0x0000000000000000000000000000000000000000

# --- Signing key -----------------------------------------------------------

# PREFERRED. Path to the relayer key file from scripts/gen-wallet.mjs --out
# .secrets. Reading it from a file keeps the key out of shell history, out of
# the process environment (visible to every child process and crash dump), and
# out of `docker inspect`.
RELAYER_PRIVATE_KEY_FILE=../.secrets/relayer.key

# Alternative: the key inline. Accepts 64 hex characters, with or without 0x.
# Only use this in a throwaway shell — it lands in the process environment.
# RELAYER_PRIVATE_KEY=

# --- GenLayer --------------------------------------------------------------

# Which chain definition to load from genlayer-js/chains. These are the export
# names of genlayer-js 2.0.0-rc.1 as published, not as the docs spell them —
# the migration doc says "studio-dev" but the package exports `studioDevnet`.
# Both spellings resolve (see CHAIN_ALIASES in src/genlayer.ts), as does
# "devnet", but the canonical name is the safest thing to put here.
#
#   studioDevnet      -> chain 61997, the v0.6 preview RPC
#   studionet         -> chain 61999, stable Studio
#   testnetBradbury   -> chain 4221, public testnet, rpc-bradbury.genlayer.com
#   testnetAsimov     -> chain 4221, rpc-asimov.genlayer.com
#
# Bradbury and Asimov share chain id 4221 in this release, so the id-based
# fallback refuses to resolve them — use the name.
#
# The escrow's immutable sourceChainId decides which is correct; the relayer
# checks the two agree at startup and refuses to run if they do not.
GENLAYER_CHAIN=studioDevnet

# Only needed when the chain has no name you can write, or when you know the id
# and it is unambiguous. Do not use this for 4221.
# GENLAYER_CHAIN_ID=61997

# The deployed RecourseJudgment contract.
GENLAYER_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Optional. A checked-in { "distribution": ..., "feeValue": ... } from
# `gltest --fee-profile`, passed to writeContract verbatim. Leave unset to
# estimate before each write, which is correct on a gasless Studio deployment
# because the estimate is what reports there is nothing to charge.
# GENLAYER_FEES_JSON=

# --- Behaviour -------------------------------------------------------------

# Seconds between sweeps for newly disputed purchases.
POLL_INTERVAL_MS=15000

# Where to remember what has been evaluated and settled, so a restart resumes
# instead of re-spending fees. Gitignored.
STATE_FILE=./.relayer-state.json

# Sign and simulate every decision, but never broadcast. Use this for the first
# run against a new deployment: it exercises the full pipeline, including the
# escrow's own signature recovery, without moving any money.
DRY_RUN=false

# debug | info | warn | error. debug prints the GenLayer SDK's actual surface,
# which is the fastest way to see what a release candidate renamed.
LOG_LEVEL=info

# Safety cap on how many purchases one sweep examines.
MAX_PURCHASES_PER_TICK=50
