# --- secrets: never commit -------------------------------------------------
.secrets/
.env
.env.*
!.env.example
*.pem
*.key

# --- node ------------------------------------------------------------------
node_modules/
.pnpm-store/
npm-debug.log*
yarn-error.log*
.pnp.*
.next/
out/
.turbo/
.vercel/
*.tsbuildinfo
next-env.d.ts

# --- solidity / foundry ----------------------------------------------------
contracts/out/
contracts/cache/
contracts/broadcast/
contracts/lib/

# Not ignored by choice — by necessity. `forge` writes the dependency key with
# the host's path separator, so a lockfile generated on Windows says
# "lib\\forge-std" and one generated on Linux says "lib/forge-std". Committing
# it would put a platform-specific file in a repo whose CI runs on Linux, and
# every CI run would rewrite it. The reproducibility it would buy is bought
# instead by pinning the tag in .github/workflows/ci.yml.
contracts/foundry.lock

# --- genlayer --------------------------------------------------------------
.genlayer/
genlayer-artifacts/
__pycache__/
*.py[cod]
.venv/
venv/

# --- relayer ---------------------------------------------------------------
dist/
# Its bookkeeping, not its source. Committing this would make one machine's run
# state look like part of the project, and a stale copy would tell a fresh clone
# that purchases were already settled.
.relayer-state.json
.relayer-state.json.tmp

# --- os / editor -----------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
