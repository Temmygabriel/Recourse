# --- secrets: never commit -------------------------------------------------
.secrets/
.env
.env.*
!.env.example
*.pem
*.key

# --- local only: never commit ----------------------------------------------
# The hand-testing walkthrough. It is written for whoever is running the demo
# at this machine — it names the .secrets/ key files, the wallets to import and
# the exact values to type — so it is working material rather than part of the
# project. Left on disk, kept off GitHub.
docs/TESTING.md

# --- node ------------------------------------------------------------------
node_modules/
.pnpm-store/
npm-debug.log*
yarn-error.log*
.pnp.*
.next/
out/
.turbo/
.vercel/
*.tsbuildinfo
next-env.d.ts

# --- solidity / foundry ----------------------------------------------------
contracts/out/
contracts/cache/
contracts/broadcast/
contracts/lib/

# Not ignored by choice — by necessity. `forge` writes the dependency key with
# the host's path separator, so a lockfile generated on Windows says
# "lib\\forge-std" and one generated on Linux says "lib/forge-std". Committing
# it would put a platform-specific file in a repo whose CI runs on Linux, and
# every CI run would rewrite it. The reproducibility it would buy is bought
# instead by pinning the tag in .github/workflows/ci.yml.
contracts/foundry.lock

# --- genlayer --------------------------------------------------------------
.genlayer/
genlayer-artifacts/
__pycache__/
*.py[cod]
.venv/
venv/

# --- relayer ---------------------------------------------------------------
dist/
# Its bookkeeping, not its source. Committing this would make one machine's run
# state look like part of the project, and a stale copy would tell a fresh clone
# that purchases were already settled.
.relayer-state.json
.relayer-state.json.tmp
# Its output, not its source. A run log records one machine's dispute at one
# moment — and the two cited in MEMORY.md are reproduced there as transcript
# text rather than as files, so nothing here is load-bearing.
*.relayer.log
relayer-live.log
run-*.log

# --- local working notes ---------------------------------------------------
# Hand-testing guide, submission notes, and other people's specs that happen to
# live in this directory. docs/TESTING.md is deliberately local-only: it names
# the .secrets/ key files and gives exact values to type.
docs/TESTING.md
docs/recourse-submission-note*.md
factor_prover_ui_fix_exact.md

