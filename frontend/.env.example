# Copy to frontend/.env.local and fill in. On Vercel, set these in
# Project Settings → Environment Variables (Production, Preview and Development
# all need them — a missing one fails the build, not just the request).

# The deployed RecourseEscrow on Base Sepolia.
# This is baked into the client bundle at build time, so changing it requires a
# redeploy. That is why it is read eagerly in src/lib/chain.ts and why a missing
# value is a build-time error rather than a blank page.
NEXT_PUBLIC_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000

# The block that escrow was deployed in. SET THIS WHENEVER YOU SET THE ADDRESS.
#
# It is not decoration: `eth_getLogs` is capped by the node, and Base's public
# RPC refuses any range wider than 10,000 blocks. The verdict, receipt and case
# screens all read the escrow's `Settled` event, so a scan that starts at block
# 0 fails outright on the public RPC — and because that read is wrapped in a
# catch, the failure does not surface as an error. It surfaces as "this purchase
# has not been through a dispute", for every purchase, including settled ones.
#
# Defaults in code to the current deployment (0xD67C…De1c) if unset, so a build
# that forgets it still works for THIS escrow — but a redeploy must move it, or
# the new escrow's settlements are invisible. Find it on the deploy transaction
# in the block explorer.
NEXT_PUBLIC_ESCROW_DEPLOY_BLOCK=46820927

# Optional. Defaults to https://sepolia.base.org, which needs no API key but is
# rate-limited. Set a keyed endpoint (Alchemy, Infura, QuickNode) if the offer
# list starts hitting 429s — the list makes one call per purchase.
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
